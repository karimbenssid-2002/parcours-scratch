{
  "name": "parcours-scratch",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --conditions=react-server --env-file=.env.production.local scripts/migrate.ts",
    "seed": "tsx --conditions=react-server --env-file=.env.local scripts/seed.ts",
    "export:contenu": "tsx --conditions=react-server --env-file=.env.production.local scripts/export-contenu.ts",
    "editor:install": "node scripts/copy-scratch-editor.mjs",
    "predev": "node scripts/copy-scratch-editor.mjs --if-missing",
    "prebuild": "node scripts/copy-scratch-editor.mjs --if-missing"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "@electric-sql/pglite": "^0.5.10",
    "@supabase/supabase-js": "^2.119.0",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.3",
    "fflate": "^0.8.3",
    "jose": "^6.2.12",
    "lucide-react": "^1.48.0",
    "next": "16.3.7",
    "playwright-core": "^1.63.0",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "sharp": "0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "better-sqlite3": "^13.0.3",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.2"
  }
}
