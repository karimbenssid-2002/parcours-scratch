# Copier en .env.local (local) ; en ligne, saisir ces variables dans le tableau de bord de l'hébergeur.
# Aucune valeur ci-dessous n'est réelle.

# Secrets de session (32 caractères minimum chacun, différents)
AUTH_SECRET=remplacer-par-une-longue-chaine-aleatoire-admin
STUDENT_AUTH_SECRET=remplacer-par-une-autre-longue-chaine-eleve

# Connexion avec Google (serveur seulement, jamais NEXT_PUBLIC_) : Google Cloud Console → Identifiants →
# ID client OAuth (application Web). Adresse de retour à déclarer : <origine du site>/auth/google/callback
# (en ligne : https://parcours-scratch.vercel.app/auth/google/callback ; en local, si besoin : http://localhost:3000/auth/google/callback).
# Sans GOOGLE_CLIENT_ID, en local seulement, les pages de connexion proposent une « connexion de développement »
# (choisir un compte existant) ; elle n'existe jamais en production ni sur Vercel.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Base PostgreSQL : PGlite dans un dossier en local (rien à installer), pooler Supabase en ligne
# (mode transaction, port 6543 : postgresql://postgres.xxxx:MOT_DE_PASSE@aws-0-eu-xxx.pooler.supabase.com:6543/postgres)
DATABASE_URL=pglite:data/dev-pg

# Compte administrateur créé par `npm run seed`, sans mot de passe : il se connecte avec Google, par cette adresse exacte.
ADMIN_EMAIL=prenom.nom@malraux-rabat.org
# Destinataire des notifications de demandes (affichées en console en local)
ADMIN_NOTIFY_EMAIL=prenom.nom@malraux-rabat.org

# E-mails réels via Resend (sans clé, les e-mails s'affichent dans la console du serveur)
# RESEND_API_KEY=
# EMAIL_FROM=Parcours Scratch <no-reply@votre-domaine.org>

# Fichiers (projets de départ et travaux des élèves) : dossier local par défaut
STORAGE_DIR=storage
# Stockage en ligne : supabase (bucket privé ; clé service_role réservée au serveur, jamais côté navigateur)
# STORAGE_BACKEND=supabase
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_BUCKET=parcours

# Correction automatique (nécessite Chromium et un serveur qui reste allumé) : 1 en local, absente en ligne
AUTOGRADE_ENABLED=1
# Propositions de note par l'IA (facultatif ; sans clé, seules les corrections tranchées sans IA fonctionnent)
# ANTHROPIC_API_KEY=
# Développement : fausse IA sans appel réseau (1), boucle de correction désactivée (off)
# AUTOGRADE_FAKE_AI=1
# AUTOGRADE_WORKER=off

# `npm run export:contenu` (lit .env.production.local) : base locale SQLite source et son dossier de fichiers
# EXPORT_SQLITE_FILE=data/app.db
# EXPORT_STORAGE_DIR=storage

# En ligne seulement : secret de la tâche planifiée quotidienne (vercel.json) qui garde la base Supabase active.
# Vercel l'envoie dans l'en-tête Authorization ; sans lui, /api/cron/veille répond 404. Longue chaîne aléatoire.
# CRON_SECRET=

# Lien « Code source » affiché en pied de page (licence AGPL-3.0) : adresse du dépôt public
# NEXT_PUBLIC_SOURCE_URL=https://github.com/karimbenssid-2002/parcours-scratch
